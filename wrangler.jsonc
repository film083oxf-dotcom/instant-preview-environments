{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "instant-preview-environments",
  "main": "src/index.js",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "APP_NAME": "Instant On-Demand Preview Environments",
    "ENVIRONMENT": "production",
    "GITHUB_REPO": "film083oxf-dotcom/instant-preview-environments",
    "PREVIEW_DOMAIN": "film083oxf.workers.dev",
    "AUTH_BASE_URL": "https://instant-preview-environments.film083oxf.workers.dev",
    "AUTH_ALLOWED_HOST_SUFFIX": "film083oxf.workers.dev"
  },
  "previews": {
    "vars": {
      "APP_NAME": "Instant On-Demand Preview Environments",
      "ENVIRONMENT": "preview"
    }
  }
}
